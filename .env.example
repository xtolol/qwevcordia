# Copy to .env locally. Environment variables override values in this file.
# Never commit your real API key.
# Leave the key empty for local Qwen work; Jev will require it.
TYPESAFE_API_KEY=
OLLAMA_HOST=http://localhost:11434
QWEN_MODEL=qwen3.5:4b
MAX_ROUNDS=20
DATA_DIR=data
# Relative DATA_DIR paths use the project directory, not the current directory.
# Positive, finite timeouts in seconds for each connection-check SDK request.
QWEN_TIMEOUT_SECONDS=120
JEV_TIMEOUT_SECONDS=30
